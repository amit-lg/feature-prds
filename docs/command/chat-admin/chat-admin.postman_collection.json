        {
          "name": "POST resolve report (hide message)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "dauth",         "value": "{{dauth}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
