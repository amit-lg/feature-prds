{
  "info": {
    "name": "Chat Admin API",
    "description": "Employee-facing chat moderation and user-facing report endpoints.\n\nSet the following collection variables before running:\n- `server`    e.g. http://localhost:3000/api\n- `dauth`     Employee platform dauth (used as Bearer token and dauth header)\n- `userDauth` User platform dauth (for user-facing report endpoints)\n- `roomId`    A valid ChatRoom id\n- `messageId` A valid ChatRoomMessage id\n- `userId`    A valid User id to report\n- `reportId`  A ChatMessageReport or ChatUserReport id\n- `beforeCursor` Auto-set by GET room messages test script",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "server",    "value": "http://localhost:3000/api", "type": "string" },
    { "key": "dauth",     "value": "",                          "type": "string" },
    { "key": "userDauth", "value": "",                          "type": "string" },
    { "key": "roomId",        "value": "1",                         "type": "string" },
    { "key": "messageId",     "value": "1",                         "type": "string" },
    { "key": "userId",        "value": "1",                         "type": "string" },
    { "key": "reportId",      "value": "1",                         "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{dauth}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Rooms",
      "item": [
        {
          "name": "GET rooms (all)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "dauth", "value": "{{dauth}}" }
            ],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms?page=0&limit=20",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms"],
              "query": [
                { "key": "page",  "value": "0" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "});",
                  "pm.test('Each room has lastMessage and openReportCount', () => {",
                  "  pm.response.json().forEach(room => {",
                  "    pm.expect(room).to.have.property('lastMessage');",
                  "    pm.expect(room).to.have.property('openReportCount');",
                  "  });",
                  "});",
                  "if (pm.response.json().length > 0) {",
                  "  pm.collectionVariables.set('roomId', pm.response.json()[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET rooms (filtered by type)",
          "request": {
            "method": "GET",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms?type=Group",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms"],
              "query": [{ "key": "type", "value": "Group" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All rooms are of type Group', () => {",
                  "  pm.response.json().forEach(r => pm.expect(r.type).to.eql('Group'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET rooms (has open report)",
          "request": {
            "method": "GET",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms?hasOpenReport=true",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms"],
              "query": [{ "key": "hasOpenReport", "value": "true" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All rooms have openReportCount > 0', () => {",
                  "  pm.response.json().forEach(r => pm.expect(r.openReportCount).to.be.above(0));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET rooms - 403 no permission",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{dauth}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Run this with a token that lacks canViewUserChats",
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET rooms (search by user name)",
          "request": {
            "method": "GET",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms?search=Riya",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms"],
              "query": [{ "key": "search", "value": "Riya" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE unban user",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/users/{{userId}}/ban",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "users", "{{userId}}", "ban"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('unbanned is true', () => {",
                  "  pm.expect(pm.response.json().unbanned).to.be.true;",
                  "});",
                  "pm.test('userId matches', () => {",
                  "  const uid = parseInt(pm.collectionVariables.get('userId'));",
                  "  pm.expect(pm.response.json().userId).to.eql(uid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE unban user - 404 not banned",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/users/{{userId}}/ban",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "users", "{{userId}}", "ban"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Run after the user has already been unbanned",
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "GET room messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms/{{roomId}}/messages?limit=30",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms", "{{roomId}}", "messages"],
              "query": [{ "key": "limit", "value": "30" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Each message has required fields', () => {",
                  "  pm.response.json().forEach(msg => {",
                  "    pm.expect(msg).to.have.property('id');",
                  "    pm.expect(msg).to.have.property('chatroomId');",
                  "    pm.expect(msg).to.have.property('isVisible');",
                  "    pm.expect(msg).to.have.property('Reactions');",
                  "    pm.expect(msg).to.have.property('MessageReports');",
                  "    pm.expect(msg).to.have.property('UserMentions');",
                  "    pm.expect(msg).to.have.property('EmployeeMentions');",
                  "  });",
                  "});",
                  "// Save cursor for load-more test",
                  "const msgs = pm.response.json();",
                  "if (msgs.length > 0) {",
                  "  pm.collectionVariables.set('beforeCursor', msgs[msgs.length - 1].id);",
                  "  pm.collectionVariables.set('messageId', msgs[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET room messages (load older via cursor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms/{{roomId}}/messages?before={{beforeCursor}}&limit=30",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms", "{{roomId}}", "messages"],
              "query": [
                { "key": "before", "value": "{{beforeCursor}}" },
                { "key": "limit",  "value": "30" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All messages have id < cursor', () => {",
                  "  const cursor = parseInt(pm.collectionVariables.get('beforeCursor'));",
                  "  pm.response.json().forEach(msg => pm.expect(msg.id).to.be.below(cursor));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST send admin message (text)",
          "request": {
            "method": "POST",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "message",   "value": "Hello from Admin",  "type": "text" },
                { "key": "displayAs", "value": "Admin",             "type": "text" }
              ]
            },
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms/{{roomId}}/messages",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms", "{{roomId}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('displayAs is Admin', () => {",
                  "  pm.expect(pm.response.json().displayAs).to.eql('Admin');",
                  "});",
                  "pm.test('employeeId is set', () => {",
                  "  pm.expect(pm.response.json().employeeId).to.be.a('number');",
                  "});",
                  "pm.test('Has full message shape', () => {",
                  "  const msg = pm.response.json();",
                  "  pm.expect(msg).to.have.property('Reactions');",
                  "  pm.expect(msg).to.have.property('MessageReports');",
                  "  pm.expect(msg).to.have.property('UserMentions');",
                  "  pm.expect(msg).to.have.property('EmployeeMentions');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST send admin message (poll)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "dauth",        "value": "{{dauth}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Please vote below!\",\n  \"displayAs\": \"Admin\",\n  \"pollQuestion\": \"Which session did you find most helpful?\",\n  \"pollOptions\": [\"Session A\", \"Session B\", \"Session C\"],\n  \"isPollMultiSelect\": false\n}"
            },
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms/{{roomId}}/messages",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms", "{{roomId}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has Polls array', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('Polls');",
                  "  pm.expect(pm.response.json().Polls).to.be.an('array');",
                  "});",
                  "pm.test('Poll has question and options', () => {",
                  "  const poll = pm.response.json().Polls[0]?.Poll;",
                  "  pm.expect(poll).to.have.property('question');",
                  "  pm.expect(poll.Options).to.be.an('array').with.lengthOf(3);",
                  "});",
                  "pm.test('isMultiple is false', () => {",
                  "  pm.expect(pm.response.json().Polls[0]?.Poll.isMultiple).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST send admin message (multi-select poll)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "dauth",        "value": "{{dauth}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Pick all that apply!\",\n  \"displayAs\": \"Admin\",\n  \"pollQuestion\": \"Which topics interest you?\",\n  \"pollOptions\": [\"Stocks\", \"Mutual Funds\", \"Crypto\", \"Real Estate\"],\n  \"isPollMultiSelect\": true\n}"
            },
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms/{{roomId}}/messages",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms", "{{roomId}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('isMultiple is true', () => {",
                  "  pm.expect(pm.response.json().Polls[0]?.Poll.isMultiple).to.be.true;",
                  "});",
                  "pm.test('Poll has 4 options', () => {",
                  "  pm.expect(pm.response.json().Polls[0]?.Poll.Options).to.have.lengthOf(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST send admin message (with file)",
          "request": {
            "method": "POST",
            "header": [{ "key": "dauth", "value": "{{dauth}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "message", "value": "See attached file", "type": "text" },
                { "key": "file",    "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{server}}/command/chat-admin/rooms/{{roomId}}/messages",
              "host": ["{{server}}"],
              "path": ["command", "chat-admin", "rooms", "{{roomId}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Attachment is populated', () => {",
                  "  const att = pm.response.json().attachment;",
                  "  pm.expect(att).to.not.be.null;",
                  "  pm.expect(att).to.have.property('url');",
                  "  pm.expect(att).to.have.property('name');",
                  "  pm.expect(att).to.have.property('type');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
